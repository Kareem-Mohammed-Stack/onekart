{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} {
    --orca-quote-accent: {% render 'brand-color', color: section.settings.accent %};
    --orca-quote-speed: {{ section.settings.speed | default: 42 }}s;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign quote_count = 0
  for block in section.blocks
    if block.settings.quote != blank
      assign quote_count = quote_count | plus: 1
    endif
  endfor
-%}

<div class="orca-quotes color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.description != blank -%}
      <header class="orca-quotes__header page-width">
        {%- if section.settings.eyebrow != blank -%}
          <p class="orca-quotes__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="QuotesHeading-{{ section.id }}" class="orca-quotes__title {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="orca-quotes__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if quote_count > 0 -%}
      <div class="orca-quotes__marquees" role="region" aria-labelledby="QuotesHeading-{{ section.id }}">
        <div class="orca-quotes__row orca-quotes__row--ltr">
          <div class="orca-quotes__track">
            <div class="orca-quotes__set">
              {%- for block in section.blocks -%}
                {%- if block.settings.quote != blank -%}
                  {% render 'orca-quote-card', block: block, editable: true %}
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="orca-quotes__set" aria-hidden="true">
              {%- for block in section.blocks -%}
                {%- if block.settings.quote != blank -%}
                  {% render 'orca-quote-card', block: block, duplicate: true %}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>

        <div class="orca-quotes__row orca-quotes__row--rtl">
          <div class="orca-quotes__track">
            <div class="orca-quotes__set">
              {%- for block in section.blocks reversed -%}
                {%- if block.settings.quote != blank -%}
                  {% render 'orca-quote-card', block: block, duplicate: true %}
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="orca-quotes__set" aria-hidden="true">
              {%- for block in section.blocks reversed -%}
                {%- if block.settings.quote != blank -%}
                  {% render 'orca-quote-card', block: block, duplicate: true %}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{{ 'orca-testimonials.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "t:sections.orca-testimonials.name",
  "tag": "section",
  "class": "section section-orca-testimonials",
  "max_blocks": 16,
  "disabled_on": {
    "groups": ["header", "custom.popup"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Loved by customers"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Real notes from people who shop with us."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 18,
      "max": 80,
      "step": 2,
      "unit": "s",
      "label": "Marquee duration",
      "default": 42
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#00284E"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.orca-testimonials.blocks.quote.name",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Arrived faster than I expected and packed carefully. I’ll order again."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Maya R."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Detail",
          "default": "Verified buyer"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.orca-testimonials.presets.name",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "Arrived faster than I expected and packed carefully. I’ll order again.",
            "author": "Maya R.",
            "role": "Verified buyer",
            "rating": 5
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "The site made it easy to find what I needed. Checkout was straightforward.",
            "author": "James L.",
            "role": "Repeat customer",
            "rating": 5
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Support answered the same day and the exchange was simple.",
            "author": "Priya S.",
            "role": "Verified buyer",
            "rating": 5
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Quality matched the photos. Feels like a store I can trust.",
            "author": "Daniel K.",
            "role": "Verified buyer",
            "rating": 5
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Bought a gift and they helped me get it there on time.",
            "author": "Elena M.",
            "role": "Verified buyer",
            "rating": 5
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Clear policies, no surprises. That’s rare online.",
            "author": "Chris T.",
            "role": "Repeat customer",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
